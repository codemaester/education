---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import CourseImage from '../../../components/CourseImage.astro';
import FinalAssessment from '../../../components/FinalAssessment.astro';
import { opticsChapters, opticsAssessment } from '../../../data/optics';
import chapters from '../../../content/optics/chapters.html?raw';
import appendix from '../../../content/optics/appendix.html?raw';
import '../../../styles/imported/optics.css';
import '../../../styles/learning.css';
const baseUrl = import.meta.env.BASE_URL;
---
<BaseLayout title="Licht, Schatten, Spiegel & Brechung – Optik" description="Optik für Klasse 9: sieben interaktive Kapitel, Erklärvideos, 105 Testfragen, schriftliche Aufgaben, Gesamtabfrage und druckbarer Lernzettel.">
  <div class="optics-page">
    <div class="page-shell"><nav class="breadcrumb" aria-label="Brotkrumennavigation"><a href={baseUrl}>Startseite</a><Icon name="chevron" size={12}/><a href={`${baseUrl}faecher/physik/`}>Physik</a><Icon name="chevron" size={12}/><span aria-current="page">Optik</span></nav>
      <header class="course-hero" id="start" tabindex="-1">
        <div><h1>Licht, Schatten,<br />Spiegel & <em>Brechung.</em></h1><p class="course-meta">Physik · Optik · Klasse 9 · Gymnasium</p><p class="course-lead">Von den Grundlagen bis zur Totalreflexion – mit interaktiven Simulationen, Merksätzen, Videos und Aufgaben.</p><div class="course-hero-actions"><a class="button" href="#k1">Mit Kapitel 1 starten <Icon name="arrow" size={18}/></a><a class="text-link" href={`${baseUrl}physik/optik/lernzettel/`}><Icon name="print" size={18}/><span>Lernzettel öffnen</span></a></div></div>
        <div class="course-art"><CourseImage priority alt="Redaktionelle Illustration einer Linse mit Lichtstrahlen in Grün und Terrakotta." /></div>
      </header>
      <details class="course-guide"><summary>So lernst du mit dieser Seite</summary><ol><li>Lies ein Kapitel langsam.</li><li>Verändere Winkel, Medien und Abstände in den Simulationen und beobachte, wie sich das Licht verhält.</li><li>Beantworte die Multiple-Choice-Aufgaben – das Feedback erscheint sofort.</li><li>Bearbeite die schriftlichen Aufgaben zuerst ohne Musterlösung.</li><li>Prüfe am Ende dein Wissen in der Gesamtabfrage und wiederhole mit dem Lernzettel.</li></ol><p>Erklärvideos benötigen Internet. Falls ein eingebetteter Player nicht funktioniert, kannst du das Video direkt auf YouTube öffnen.</p></details>
    </div>
    <div class="toolbar"><div class="container toolbar-inner">
      <details class="chapter-menu" id="chapter-menu"><summary aria-label="Kapitelmenü öffnen"><Icon name="book" size={19}/><span>Alle Kapitel</span><span class="menu-current" aria-live="polite">Übersicht</span><Icon name="chevron" size={14}/></summary><nav class="chapter-picker" aria-label="Direkt zu einem Kapitel springen"><a href="#start">Übersicht</a>{opticsChapters.map((chapter, index) => <a href={`#${chapter.id}`}>{String(index + 1).padStart(2, '0')} · {chapter.short}</a>)}<a href="#gesamtcheck">Gesamtabfrage</a><a href="#checkliste">Prüfungs-Checkliste</a></nav></details>
      <div class="toolbar-shortcuts" aria-label="Schnellzugriff"><a class="btn" href="#k1">Kapitel 1</a><a class="btn" href="#gesamtcheck">Gesamtabfrage</a><a class="btn" href="#checkliste">Checkliste</a></div>
      <a class="btn study-sheet-link" href={`${baseUrl}physik/optik/lernzettel/`}><Icon name="print" size={19}/>Lernzettel</a>
    </div></div>
    <div class="container layout"><nav class="side" aria-label="Kapitelübersicht">{opticsChapters.map((chapter, index) => <a href={`#${chapter.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{chapter.title}</a>)}<a href="#gesamtcheck"><Icon name="check" size={16}/>Gesamtabfrage</a><a href="#checkliste"><Icon name="book" size={16}/>Prüfungs-Checkliste</a></nav><div class="lesson-content"><Fragment set:html={chapters}/><FinalAssessment questions={opticsAssessment}/><Fragment set:html={appendix}/></div></div>
    <p class="container course-note">Erstellt als Lernhilfe für die Themenliste „Lernkontrolle 9a – 1. HJ 2026/2027“. Diese Seite ersetzt nicht die Hinweise der Lehrkraft; bei abweichender Unterrichtsnotation gilt die im Unterricht verwendete Schreibweise.</p>
  </div>
</BaseLayout>
<script>import '../../../scripts/optics.js';</script>
