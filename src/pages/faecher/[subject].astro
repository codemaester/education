---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CourseImage from '../../components/CourseImage.astro';
import { subjects, coursesForSubject } from '../../data/catalog';
import type { Subject } from '../../data/catalog';
import '../../styles/catalog.css';
export function getStaticPaths() { return subjects.map(subject => ({ params: { subject: subject.slug }, props: { subject } })); }
interface Props { subject: Subject; }
const { subject } = Astro.props;
const courses = coursesForSubject(subject.slug);
const baseUrl = import.meta.env.BASE_URL;
---
<BaseLayout title={subject.name} description={subject.description}>
  <div class="page-shell">
    <nav class="breadcrumb" aria-label="Brotkrumennavigation"><a href={baseUrl}>Startseite</a><Icon name="chevron" size={12}/><a href={`${baseUrl}#faecher`}>Fächer</a><Icon name="chevron" size={12}/><span aria-current="page">{subject.name}</span></nav>
    <section class="subject-hero"><div><h1>{subject.name}</h1><p>{subject.description}</p></div><span class="subject-symbol" data-tone={subject.tone}><Icon name={subject.icon} size={42} /></span></section>
    <section class="subject-courses" aria-labelledby="courses-title">
      {courses.length ? <>
        <h2 id="courses-title">Dein nächstes Aha-Erlebnis.</h2>
        {courses.map(course => <a class="course-list-entry" href={`${baseUrl}${course.href}`}><CourseImage kind={course.cover} priority /><div><small>{course.level} · {course.chapters} {course.chapterLabel ?? 'Kapitel'}</small><h3>{course.title}</h3><p>{course.description}</p><span class="text-link">Lernseite entdecken <Icon name="arrow" size={18}/></span></div><Icon name="arrow" size={26}/></a>)}
      </> : <div class="empty-subject"><h2 id="courses-title">Hier ist noch Raum<br />für Entdeckungen.</h2><p>Für {subject.name} gibt es aktuell noch keine Lernseiten in der Sammlung. Du kannst schon die Optik erkunden oder dich in den anderen Fächern umsehen.</p><div class="empty-subject-actions"><a class="button" href={`${baseUrl}physik/optik/`}>Optik entdecken <Icon name="arrow" size={18}/></a><a class="button button-secondary" href={`${baseUrl}#faecher`}>Zur Fächerübersicht</a></div></div>}
    </section>
  </div>
</BaseLayout>
