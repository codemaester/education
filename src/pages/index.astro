---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Hello World!">
  <h1>Hello World!</h1>
  <p class="intro">
    Hier entsteht eine Sammlung von Lernseiten. Zum Entdecken, Verstehen
    und Ausprobieren.
  </p>

  <section class="experiment" aria-labelledby="experiment-title">
    <h2 id="experiment-title">Ein erster Klick.</h2>
    <p>Probiere den Zähler aus. Mit jedem Klick geht es einen Schritt weiter.</p>
    <div class="counter-controls">
      <button id="increment" type="button" disabled>Weiterzählen</button>
      <p class="counter-value" role="status" aria-live="polite" aria-atomic="true">
        Klicks: <span id="count">0</span>
      </p>
    </div>
    <noscript>
      <p>Aktiviere JavaScript, um den Zähler auszuprobieren.</p>
    </noscript>
  </section>
</BaseLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>('#increment');
  const output = document.querySelector<HTMLSpanElement>('#count');

  if (button && output) {
    let count = 0;
    button.addEventListener('click', () => {
      count += 1;
      output.textContent = String(count);
    });
    button.disabled = false;
  }
</script>
