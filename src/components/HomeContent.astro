---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import FeaturedCourses from './FeaturedCourses.astro';
import { subjects, courses, coursesForSubject } from '../data/catalog';
import '../styles/catalog.css';
const baseUrl = import.meta.env.BASE_URL;
---
<BaseLayout title="Entdecken. Verstehen. Anwenden." description="Interaktive Lernseiten für neugierige Köpfe. Entdecke verschiedene Fächer, probiere Zusammenhänge aus und teste dein Wissen.">
  <div class="page-shell">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">Aus Neugier<br />wird <em>Verstehen.</em></h1>
      <div class="home-intro-copy"><p>Lernen heißt, die Welt ein bisschen besser zu verstehen. Hier findest du Raum zum Entdecken, Ausprobieren und Weiterdenken.</p><a class="text-link" href="#faecher"><span>Entdecke dein Fach</span><Icon name="arrow" /></a></div>
    </section>
    <FeaturedCourses courses={courses} />
    <section class="subjects-section" id="faecher" aria-labelledby="subjects-title">
      <div class="section-heading"><h2 id="subjects-title">Viele Fächer.<br /><em>Neue Perspektiven.</em></h2><p>Jedes Fach öffnet eine andere Tür.<br />Womit möchtest du anfangen?</p></div>
      <div class="subjects-list">{subjects.map(subject => {
        const count = coursesForSubject(subject.slug).length;
        return <a class="subject-entry" href={`${baseUrl}faecher/${subject.slug}/`}><span class="subject-symbol" data-tone={subject.tone}><Icon name={subject.icon} size={27} /></span><span class="subject-description"><strong>{subject.name}</strong><span>{subject.description}</span><small class:list={{ available: count > 0 }}>{count ? `${count} Lernseite entdecken` : 'Noch keine Lernseiten'}</small></span><Icon name="arrow" size={21} /></a>;
      })}</div>
    </section>
    <section class="learning-approach" aria-labelledby="approach-title"><div><Icon name="book" size={30} /><h2 id="approach-title">Verstehen beginnt<br /><em>beim Ausprobieren.</em></h2></div><p>Verändere einen Winkel. Beobachte, was passiert. Stelle Fragen und teste dein Wissen. Und nimm die wichtigsten Gedanken als Lernzettel mit.</p><a class="text-link" href="#faecher"><span>Eine Lernseite finden</span><Icon name="arrow" /></a></section>
  </div>
</BaseLayout>
