---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  skipTo?: string;
}

const {
  title,
  description = 'Education – eine Sammlung verschiedener Lernseiten.',
  pageClass,
  skipTo = 'inhalt',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title} | Education</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href={`#${skipTo}`}>Zum Inhalt</a>
    <header class="site-header">
      <div class="page-shell header-inner">
        <a class="brand" href={baseUrl} aria-label="Education – Startseite">
          <svg class="brand-mark" viewBox="0 0 40 44" fill="none" aria-hidden="true"><path d="M20 3C3 9 3 35 20 41c17-6 17-32 0-38Z" stroke="currentColor" stroke-width="1.4"/><path d="M2 22h36M8 9l24 26M8 35 32 9" stroke="currentColor" stroke-width="1.1"/><circle cx="20" cy="22" r="3" fill="var(--color-terracotta)"/></svg>
          <span class="brand-name">Education<span aria-hidden="true">.</span></span>
        </a>
        <nav class="site-nav" aria-label="Hauptnavigation">
          <a href={`${baseUrl}#faecher`}>Fächer entdecken</a>
        </nav>
      </div>
    </header>
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page-shell footer-inner">
        <p>Education. <span>Für die Freude am Verstehen.</span></p>
        <div class="footer-links"><a href={`${baseUrl}#faecher`}>Alle Fächer</a></div>
      </div>
    </footer>
  </body>
</html>
